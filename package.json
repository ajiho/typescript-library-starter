{
  "name": "typescript-library-starter",
  "version": "0.0.0",
  "description": "A modern starter template for building TypeScript libraries.",
  "keywords": [
    "library-starter",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/ajiho/typescript-library-starter/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajiho/typescript-library-starter.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "pnpm run lint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "tsdown": "tsdown",
    "build": "run-s clean tsdown size",
    "dev": "pnpm run tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --coverage",
    "test:ui": "pnpm run test --ui",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "check": "run-s lint typecheck coverage build publint"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
