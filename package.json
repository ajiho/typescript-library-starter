{
  "name": "typescript-library-starter",
  "version": "0.0.0",
  "description": "A modern starter template for building TypeScript libraries.",
  "keywords": [
    "library-starter",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/ajiho/typescript-library-starter/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajiho/typescript-library-starter.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "pnpm run lint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "tsdown": "tsdown",
    "build": "run-s clean tsdown size",
    "dev": "pnpm run tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --coverage",
    "test:ui": "pnpm run test --ui",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "check": "run-s lint typecheck coverage build publint"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
